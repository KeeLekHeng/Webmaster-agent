# Copy to .env in the directory where you run Guardian. Never commit real keys.
AGENT_ENABLED=true
GUARDIAN_CONFIG=config/sites.json
GUARDIAN_OUTPUT=reports
GUARDIAN_DB=data/guardian.sqlite3
GUARDIAN_STOP_FILE=data/STOP
# Required only for --llm claude. Existing shell variables take precedence.
ANTHROPIC_API_KEY=
GUARDIAN_MODEL=
# Optional future repository API access. Do not reuse a broad ambient token.
# GUARDIAN_GITHUB_READ_TOKEN=
# GUARDIAN_GITHUB_WRITE_TOKEN=
# Optional owner-enrolled local publishing policy (keep this file out of Git).
# GUARDIAN_REPOSITORIES=data/repositories.local.json
# Period review: optional existing Google read-only OAuth access token (short-lived).
# Confirm verified Search Console access before configuring. Not a Google API key.
GUARDIAN_GSC_PROPERTY=
GUARDIAN_GSC_ACCESS_TOKEN=
# Persistent authorization: use your own Google OAuth client and read-only grant.
# When any of these are set, all three are required; manual access token is ignored.
GUARDIAN_GSC_CLIENT_ID=
GUARDIAN_GSC_CLIENT_SECRET=
GUARDIAN_GSC_REFRESH_TOKEN=
# Optional PageSpeed API key, independent of Search Console OAuth.
GUARDIAN_PAGESPEED_API_KEY=
